decl doc_prod(lstx, lsty) {
    var sum = 0;
    var i = 0;
    while (i < lenof(lstx)) {
        sum = sum + lstx[i] * lsty[i];  // Calculate the dot product
        i = i + 1;
    }
    ret sum;
}

decl mul_row(row, cols, idx) {
    if (idx >= lenof(cols)) {
        ret [];
    }
    var result = doc_prod(row, get_col(cols, idx));
    ret [result] + mul_row(row, cols, idx + 1);
}

decl matrix_mul(ma, mb) {
    if (lenof(ma) == 0) {
        ret [];
    }

    var result = [];
    var i = 0;

    while (i < lenof(ma)) {
        result = result + [mul_row(ma[i], mb, 0)];  // Multiply row i
        i = i + 1;
    }

    ret result;
}

decl get_col(matrix, idx) {
    if (lenof(matrix) == 0) {
        ret [];
    }
    ret [matrix[0][idx]] + get_col(matrix[1:], idx);
}

decl perform_matrix_mul_work(times, x) {
    var i = 0;
    while (i < times) {
        matrix_mul(x, x);  // Perform matrix multiplication
        i = i + 1;
    }
}

var x = [
    [199, 504, 597, 815, 774, 194, 555, 240, 324, 314, 503], 
    [108, 521, 588, 113, 824, 907, 515, 675, 738, 644, 344], 
    [327, 296, 284, 520, 123, 557, 790, 552, 445, 860, 566], 
    [6, 863, 565, 638, 121, 757, 326, 301, 731, 672, 496], 
    [850, 643, 248, 24, 801, 332, 956, 415, 789, 52, 165], 
    [286, 576, 106, 795, 157, 279, 586, 860, 63, 186, 86], 
    [290, 404, 304, 645, 607, 172, 827, 305, 444, 699, 322], 
    [9, 253, 446, 307, 899, 113, 131, 884, 985, 297, 539], 
    [554, 122, 8, 574, 225, 253, 447, 91, 555, 794, 786], 
    [635, 132, 109, 735, 29, 681, 264, 488, 207, 622, 374], 
    [872, 751, 958, 287, 146, 777, 305, 370, 540, 152, 46]
];

// Start 4 threads to perform 1000 matrix multiplications each
var num_threads = 4;
var work_per_thread = 10;

var i = 0;
while (i < num_threads) {

        perform_matrix_mul_work(work_per_thread, x);  // Each thread performs 1000 matrix multiplications
    
    i = i + 1;
}
